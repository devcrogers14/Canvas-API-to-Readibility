# Paste your Canvas API key after the equals sign, then restart the server.
CANVAS_API_KEY=

# This is the separate secret Lucas sends to access our server.
# Generate it with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep the real token private and restart the server after changing it.
MCP_SERVER_TOKEN=

